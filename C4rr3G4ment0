    end)
    if not loadOk then
        showNotification("❌ Erro no script do jogo!")
        warn("[Elixir Script ERROR] " .. tostring(loadErr))
        -- Mostra a linha exata do erro
        local lineNum = tonumber(string.match(tostring(loadErr), ":(%d+):"))
        if lineNum then
            warn("[Elixir] Erro na linha " .. lineNum .. " do script do jogo")
        end
    else
        showNotification("✅ " .. gameName .. " carregado com sucesso!")
    end
